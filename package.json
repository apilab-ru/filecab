{
  "name": "filecab",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "code": "codex --ask-for-approval never --sandbox danger-full-access",
    "dev": "nx run-many -t dev --projects=web,api,extension --parallel=3",
    "dev:web": "nx dev web",
    "dev:extension": "nx dev extension",
    "dev:api": "nx dev api",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run --project unit",
    "test:contracts": "vitest run --project contracts",
    "test:integration": "pnpm --filter @filecab/api db:generate && vitest run --project integration",
    "test:e2e": "nx build extension && playwright test",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "db:generate": "pnpm --filter @filecab/api db:generate",
    "db:validate": "pnpm --filter @filecab/api db:validate",
    "db:migrate": "pnpm --filter @filecab/api db:migrate",
    "db:deploy": "pnpm --filter @filecab/api db:deploy",
    "db:status": "pnpm --filter @filecab/api db:status",
    "db:start": "brew services run postgresql@17",
    "db:stop": "brew services stop postgresql@17",
    "db:service-status": "brew services info postgresql@17",
    "format": "eslint . --fix && prettier --write .",
    "format:affected": "lint-staged --diff=HEAD",
    "format:check": "eslint . && prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "husky": "9.1.7",
    "lint-staged": "^16.4.0",
    "nx": "24.0.3",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "vitest": "4.1.12"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.{js,mjs,cjs,jsx,ts,tsx,mts,cts})": "prettier --write --ignore-unknown"
  }
}
