{
  "name": "@filecab/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm storage:generate && wxt",
    "build": "pnpm storage:generate && wxt build",
    "prepare": "pnpm storage:generate && wxt prepare",
