{
  "title": "Recoverable synchronization intent",
  "version": 0,
  "primaryKey": "id",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64
    },
    "ownerId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "proposed": {
      "$ref": "#/definitions/entry"
    },
    "kind": {
      "type": "string",
      "enum": ["conflict", "reset"]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "conflict": {
      "type": "object",
      "properties": {
        "entryId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "reason": {
          "type": "string",
          "enum": ["VERSION", "IDENTITY", "SOURCE", "CATEGORY"]
        },
        "serverDocument": {
          "anyOf": [
            {
              "$ref": "#/definitions/entry"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["entryId", "reason", "serverDocument"],
      "additionalProperties": false
    }
  },
  "required": ["id", "ownerId", "proposed", "kind", "recordedAt", "conflict"],
  "additionalProperties": false,
  "definitions": {
    "entry": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "entryId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "catalogId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "type": "string",
          "enum": ["anime", "films", "tv"]
        },
        "userTitle": {
          "type": "string",
          "maxLength": 10000
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["planned", "process", "complete", "drop", "hide"]
            },
            {
              "type": "null"
            }
          ]
        },
        "rating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "progress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "comment": {
          "type": "string",
          "maxLength": 1000000
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "originalUrl": {
                "type": "string",
                "maxLength": 8192
              },
              "normalizedUrl": {
                "type": "string",
                "maxLength": 8192
              },
              "policyVersion": {
                "type": "string",
                "const": "generic-v1"
              }
            },
            "required": ["originalUrl", "normalizedUrl", "policyVersion"],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "originalTitle": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "language": {
                      "type": "string"
                    },
                    "provenance": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string"
                        },
                        "retrievedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "verified": {
                          "type": "boolean"
                        }
                      },
                      "required": ["source", "retrievedAt", "verified"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["text", "language", "provenance"],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "titles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  },
                  "provenance": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string"
                      },
                      "retrievedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "verified": {
                        "type": "boolean"
                      }
                    },
                    "required": ["source", "retrievedAt", "verified"],
                    "additionalProperties": false
                  }
                },
                "required": ["text", "language", "provenance"],
                "additionalProperties": false
              }
            },
            "descriptions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  },
                  "provenance": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string"
                      },
                      "retrievedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "verified": {
                        "type": "boolean"
                      }
                    },
                    "required": ["source", "retrievedAt", "verified"],
                    "additionalProperties": false
                  }
                },
                "required": ["text", "language", "provenance"],
                "additionalProperties": false
              }
            },
            "posterUrl": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "year": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9999
                },
                {
                  "type": "null"
                }
              ]
            },
            "genres": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "genreId": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "labels": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "language": {
                          "type": "string"
                        },
                        "provenance": {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string"
                            },
                            "retrievedAt": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "verified": {
                              "type": "boolean"
                            }
                          },
                          "required": ["source", "retrievedAt", "verified"],
                          "additionalProperties": false
                        }
                      },
                      "required": ["text", "language", "provenance"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["genreId", "key", "labels"],
                "additionalProperties": false
              }
            },
            "format": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "movie",
                    "tv",
                    "special",
                    "ova",
                    "ona",
                    "music",
                    "cartoon",
                    "tv-series",
                    "animated-series",
                    "unknown"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "episodeCount": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "availableEpisodeCount": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "providerRatings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "provenance": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string"
                      },
                      "retrievedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "verified": {
                        "type": "boolean"
                      }
                    },
                    "required": ["source", "retrievedAt", "verified"],
                    "additionalProperties": false
                  }
                },
                "required": ["value", "scale", "provenance"],
                "additionalProperties": false
              }
            },
            "references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "namespace": {
                    "type": "string"
                  },
                  "entity": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "granularity": {
                    "type": "string",
                    "enum": ["series", "season", "film", "special", "edition", "unknown"]
                  },
                  "provenance": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string"
                      },
                      "retrievedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "verified": {
                        "type": "boolean"
                      }
                    },
                    "required": ["source", "retrievedAt", "verified"],
                    "additionalProperties": false
                  }
                },
                "required": ["namespace", "entity", "id", "granularity", "provenance"],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "originalTitle",
            "titles",
            "descriptions",
            "posterUrl",
            "year",
            "genres",
            "format",
            "episodeCount",
            "availableEpisodeCount",
            "providerRatings",
            "references"
          ],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverVersion": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "deleted": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "entryId",
        "catalogId",
        "category",
        "userTitle",
        "status",
        "rating",
        "progress",
        "comment",
        "sources",
        "snapshot",
        "createdAt",
        "updatedAt",
        "serverVersion",
        "deleted"
      ],
      "additionalProperties": false
    }
  }
}
