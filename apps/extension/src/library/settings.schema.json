{
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "maxLength": 32
    },
    "category": {
      "type": "string",
      "enum": ["anime", "films", "tv"]
    },
    "mode": {
      "type": "string",
      "enum": ["library", "catalog"]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "preferences": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 1000
        },
        "sort": {
          "type": "string",
          "enum": ["updated", "title"]
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["planned", "process", "complete", "drop", "hide"]
            },
            {
              "type": "null"
            }
          ]
        },
        "locale": {
          "type": "string",
          "enum": ["en", "ru"]
        }
      },
      "required": ["query", "sort", "pageSize", "status", "locale"],
      "additionalProperties": false
    }
  },
  "required": ["key", "category", "mode", "revision", "preferences"],
  "additionalProperties": false,
  "title": "Local library preferences",
  "version": 0,
  "primaryKey": "key"
}
