{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/.wxt/**/*",
      "!{projectRoot}/.output/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/pnpm-lock.yaml"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/.output"
      ],
      "inputs": [
        "default",
        "^default"
      ]
    },
    "typecheck": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ]
    },
    "dev": {
      "cache": false,
      "continuous": true
    }
  },
  "analytics": false
}